NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Browser origin of the Moscow reverse-proxy. Production builds default to
# https://sb.uniquevocal.ru even if this is left empty.
NEXT_PUBLIC_SUPABASE_PROXY_URL=https://sb.uniquevocal.ru
SUPABASE_SERVICE_ROLE_KEY=

# Generate once with: npm run generate-vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:iris.jar008@gmail.com

# Email fallback for notifications unread after 5 minutes
# Vercel Cron calls /api/notifications/email-fallback every minute (see vercel.json)
RESEND_API_KEY=
EMAIL_FROM=Unique Vocal Studio <notifications@your-domain.ru>
CRON_SECRET=
NEXT_PUBLIC_APP_URL=https://your-domain.ru

# Unlisted admin sign-in: /gate/<slug>. Do not put this URL on the public site.
NEXT_PUBLIC_ADMIN_GATE_SLUG=


# Required for real Meta Demucs v4 separation via Hugging Face Space.
# Without it, /api/ai/separate-vocal returns an honest 503 (no fake audio).
HUGGINGFACE_API_KEY=

# Optional override (default: abidlabs/music-separation — vocals + instrumental)
# DEMUCS_HF_SPACE=abidlabs/music-separation

# Optional gender model for timbre tool (HF Inference)
# TIMBRE_GENDER_HF_MODEL=prithivMLmods/Common-Voice-Gender-Detection

# Neural voice twin (REQUIRED for real celebrity matching).
# Deploy folder spaces/voice-twin as a Hugging Face Space, then set:
# VOICE_MATCH_HF_SPACE=your-hf-user/unique-vocal-voice-twin
# Add Shakira etc. as spaces/voice-twin/extra_refs/*.wav before deploy.
VOICE_MATCH_HF_SPACE=

# Optional: recognize commercial tracks from speakers (Ed Sheeran etc.)
# Free token: https://dashboard.audd.io/
# AUDD_API_TOKEN=

# Payment: YooKassa only (pay-api on the VPS). Never commit real keys.
PAYMENT_PROVIDER=yookassa
NEXT_PUBLIC_PAYMENT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_IS_TEST=1