[Unit]
Description=UniqueVocal Web Push dispatcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/uniquevocal/push-api.env
WorkingDirectory=/opt/push-api
ExecStart=/usr/bin/node /opt/push-api/server.mjs
Restart=always
RestartSec=3
User=www-data
Group=www-data
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
