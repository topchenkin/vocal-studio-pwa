[Unit]
Description=UniqueVocal Supabase reverse proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/uniquevocal/sb-proxy.env
WorkingDirectory=/opt/sb-proxy
ExecStart=/usr/bin/node /opt/sb-proxy/server.mjs
Restart=always
RestartSec=3
User=www-data
Group=www-data
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
