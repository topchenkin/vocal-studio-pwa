{
	email iris.jar008@gmail.com
	# VPN-safe front door. Do not re-enable HTTP/3 (h3) or TLS 1.3.
	# Many RU/VPN paths drop QUIC/UDP and TLS 1.3 ClientHello; the tab then
	# looks "unreachable" while TCP 443 is open. TLS 1.2 + HTTP/1.1+2 works.
	# 0-RTT is off because TLS 1.3 is off.
	servers {
		protocols h1 h2
	}
}

# Static export. Never SPA-fallback /_next — that is the black-screen bug.
(tls12) {
	tls {
		protocols tls1.2 tls1.2
		alpn http/1.1 h2
		ciphers TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256
	}
}

(site) {
	header Alt-Svc "clear"
	header Permissions-Policy "microphone=(self), camera=(self)"
	root * /var/www/uniquevocal
	encode gzip
	redir /dashboard/student/pocket-studio /dashboard/student 302
	redir /dashboard/student/ai-music /dashboard/student/ai-tools 302
	redir /dashboard/student/songwriter /dashboard/student/ai-tools 302
	handle /_next/* {
		@nextFound file
		header @nextFound Cache-Control "public, max-age=31536000, immutable"
		@nextMissing not file
		header @nextMissing Cache-Control "no-store"
		file_server
	}
	handle /sw.js {
		header Cache-Control "no-store"
		file_server
	}
	@pwaWorkers {
		path /worker-*.js /fallback-*.js /workbox-*.js
	}
	handle @pwaWorkers {
		header Cache-Control "no-store"
		file_server
	}
	@assetFiles {
		path *.js *.css *.map *.mjs
	}
	handle @assetFiles {
		header Cache-Control "no-store"
		file_server
	}
	handle /api/payments* {
		reverse_proxy 127.0.0.1:8791 {
			transport http {
				versions 1.1
				read_timeout 30s
				write_timeout 30s
				dial_timeout 5s
			}
		}
	}
	handle /api/yookassa* {
		reverse_proxy 127.0.0.1:8791 {
			transport http {
				versions 1.1
				read_timeout 30s
				write_timeout 30s
				dial_timeout 5s
			}
		}
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8788 {
			transport http {
				versions 1.1
				read_timeout 300s
				write_timeout 300s
				dial_timeout 10s
			}
		}
	}
	handle {
		header Cache-Control "no-store, no-cache, must-revalidate"
		header Pragma "no-cache"
		try_files {path} {path}.html {path}/index.html /index.html
		file_server
	}
}

# Preview by IP and HTTP-01. Proxy health stays on /__health.
http://5.42.123.142 {
	handle /__health {
		reverse_proxy 127.0.0.1:8787
	}
	import site
}

www.uniquevocal.ru, uniquevocal.ru {
	import tls12
	import site
}

sb.uniquevocal.ru {
	import tls12
	header Alt-Svc "clear"
	handle /__health {
		respond "ok" 200
	}
	handle {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
			header_up Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			transport http {
				versions 1.1
				read_timeout 0
				write_timeout 0
				dial_timeout 5s
			}
		}
	}
}
