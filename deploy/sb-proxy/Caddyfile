{
	email iris.jar008@gmail.com
	servers {
		protocols h1 h2
	}
}

# Static export. Never SPA-fallback /_next — that is the black-screen bug.
# HTTP/3 (QUIC) is off: many VPNs drop UDP and the tab looks like it "fell off".
# TLS 1.3 ClientHello is dropped on some RU/VPN paths (TCP 443 opens, handshake
# hangs). TLS 1.2 still completes. Browsers all speak 1.2.
(tls12) {
	tls {
		protocols tls1.2 tls1.2
	}
}

(site) {
	header Alt-Svc "clear"
	root * /var/www/uniquevocal
	encode gzip
	handle /_next/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /sw.js {
		header Cache-Control "no-store"
		file_server
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8788 {
			transport http {
				versions 1.1
				read_timeout 300s
				write_timeout 300s
				dial_timeout 10s
			}
		}
	}
	handle {
		header Cache-Control "no-cache"
		try_files {path} {path}.html {path}/index.html /index.html
		file_server
	}
}

# Preview by IP and HTTP-01. Proxy health stays on /__health.
http://5.42.123.142 {
	handle /__health {
		reverse_proxy 127.0.0.1:8787
	}
	import site
}

www.uniquevocal.ru, uniquevocal.ru {
	import tls12
	import site
}

sb.uniquevocal.ru {
	import tls12
	header Alt-Svc "clear"
	handle /__health {
		respond "ok" 200
	}
	handle {
		reverse_proxy 127.0.0.1:8000 {
			flush_interval -1
			header_up Host {host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
			transport http {
				versions 1.1
				read_timeout 0
				write_timeout 0
				dial_timeout 5s
			}
		}
	}
}
