[Unit]
Description=UniqueVocal Demucs AI API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/uniquevocal/ai-api.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/opt/ai-api
ExecStart=/usr/bin/node /opt/ai-api/server.mjs
Restart=always
RestartSec=3
User=www-data
Group=www-data
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
