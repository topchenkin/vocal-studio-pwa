# Leftover Timeweb Frontend Apps. Serve `out/` after `npm run build`.
# Do not SPA-fallback /_next — that rewrites JS/CSS to index.html.
www.uniquevocal.ru, uniquevocal.ru {
	root * out
	encode gzip
	handle /_next/* {
		file_server
	}
	handle {
		try_files {path} {path}.html {path}/index.html
		file_server
	}
}
