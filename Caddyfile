# Timeweb App Platform (UniqueVocal Frontend).
# Support asked to keep www as-is and add sb.uniquevocal.ru.
# If the platform uses this file as the *entire* Caddy config, www still
# serves the static export from `out/` (or /srv in Docker).

www.uniquevocal.ru, uniquevocal.ru {
	root * {$SITE_ROOT:out}
	encode gzip
	try_files {path} /index.html
	file_server
}

sb.uniquevocal.ru {
	reverse_proxy http://147.45.136.24 {
		header_up Host 147.45.136.24
	}
}
