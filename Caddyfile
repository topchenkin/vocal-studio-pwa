# Leftover Timeweb Frontend Apps (92.246.76.92).
# Serve the Next static export. Never SPA-fallback /_next to index.html
# (that is the black screen). reverse_proxy was ignored by App Platform.
www.uniquevocal.ru, uniquevocal.ru {
	root * out
	encode gzip
	handle /_next/* {
		file_server
	}
	handle {
		try_files {path} {path}.html {path}/index.html
		file_server
	}
}
